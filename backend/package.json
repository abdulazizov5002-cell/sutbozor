{
  "name": "sutbozor-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SutBozor backend foundation (Fastify + TypeScript + Zod). Database bosqichida Prisma/PostgreSQL ulanadi.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "npm run test:contract && npm run test:telegram && npm run test:auth && npm run test:register && npm run test:products && npm run test:orders && npm run test:paymentplan && npm run test:payments && npm run test:disputes && npm run test:users && npm run test:notifications && npm run test:notify && npm run test:ratings && npm run test:rbac && npm run test:logging && npm run test:http && npm run test:products-http && npm run test:orders-http && npm run test:payments-http && npm run test:disputes-http && npm run test:users-http && npm run test:notifications-http && npm run test:ratings-http",
    "test:contract": "tsx tests/contract.test.ts",
    "test:http": "tsx --test tests/http.test.ts",
    "test:telegram": "tsx tests/telegram.test.ts",
    "test:auth": "tsx tests/auth.test.ts",
    "test:register": "tsx tests/register.test.ts",
    "test:products": "tsx tests/products.test.ts",
    "test:products-http": "tsx --test tests/products.http.test.ts",
    "test:orders": "tsx tests/orders.test.ts",
    "test:orders-http": "tsx --test tests/orders.http.test.ts",
    "test:paymentplan": "tsx tests/paymentPlan.test.ts",
    "test:payments": "tsx tests/payments.test.ts",
    "test:payments-http": "tsx --test tests/payments.http.test.ts",
    "test:disputes": "tsx tests/disputes.test.ts",
    "test:disputes-http": "tsx --test tests/disputes.http.test.ts",
    "test:users": "tsx tests/users.test.ts",
    "test:users-http": "tsx --test tests/users.http.test.ts",
    "test:notifications": "tsx tests/notifications.test.ts",
    "test:notifications-http": "tsx --test tests/notifications.http.test.ts",
    "test:ratings": "tsx tests/ratings.test.ts",
    "test:ratings-http": "tsx --test tests/ratings.http.test.ts",
    "test:notify": "tsx tests/notify.test.ts",
    "test:rbac": "tsx tests/rbac.test.ts",
    "test:logging": "tsx tests/logging.test.ts",
    "check:secrets": "node scripts/check-secrets.js",
    "check:secrets:staged": "node scripts/check-secrets.js --staged"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
