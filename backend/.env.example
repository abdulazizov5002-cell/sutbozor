# SutBozor backend sozlamalari. Bu faylni .env nomi bilan nusxalang: cp .env.example .env
# Haqiqiy parol va maxfiy kalitlarni .env.example ga YOZMANG. .env git'ga qo'shilmaydi (.gitignore).
# Commit oldidan: npm run check:secrets

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Productionda majburiy. Developmentda berilmasa entity endpointlari 501 qaytaradi.
DATABASE_URL=postgresql://sutbozor:CHANGE_ME@localhost:5432/sutbozor?schema=public

# Vergul bilan ajratilgan frontend manzillari (https://app.example.com shaklida, oxirida "/" siz).
# Productionda faqat https va "*" taqiqlangan.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

LOG_LEVEL=info

# So'rov hajmi (bayt) va vaqti (ms)
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000

# Rate limit: oyna (soniya) va oynadagi maksimal so'rov soni (IP bo'yicha)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_MAX=30
# Reverse proxy (nginx, Cloudflare) orqasida ishlasa true qiling, aks holda limit noto'g'ri IP ko'radi.
TRUST_PROXY=false

# Autentifikatsiya bosqichida kerak bo'ladi. Qiymatlarni faqat .env yoki hosting sirlar bo'limida saqlang.
# JWT_SECRET: kamida 32 belgi, tasodifiy. Hosil qilish: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
# ACCESS_TOKEN_TTL_MIN=15
# TELEGRAM_BOT_TOKEN=
# initData necha soniyadan eski bo'lsa rad etiladi (60..604800, standart 86400). Tekshiruv keyingi bosqichda ishga tushadi.
# TELEGRAM_INIT_DATA_MAX_AGE_SEC=86400
